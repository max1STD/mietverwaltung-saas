# ──────────────────────────────────────────────
# MietVerwaltung SaaS — Environment Example
# Copy to .env and fill with real values
# ──────────────────────────────────────────────

# ── App ──
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-64-char-string

# ── Database ──
POSTGRES_DB=mietverwaltung
POSTGRES_USER=mv
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://mv:change-me@db:5432/mietverwaltung

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── JWT ──
JWT_SECRET=change-me-to-a-different-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ── KI (Ollama Cloud) ──
OLLAMA_API_URL=https://ollama.com/v1
OLLAMA_API_KEY=change-me
OLLAMA_MODEL_DEFAULT=glm-5.2
OLLAMA_MODEL_COMPLEX=kimi-k2.6

# ── E-Mail (Resend) ──
RESEND_API_KEY=change-me
FROM_EMAIL=noreply@mietverwaltung.de

# ── Stripe ──
STRIPE_PUBLISHABLE_KEY=pk_test_change-me
STRIPE_SECRET_KEY=sk_test_change-me
STRIPE_WEBHOOK_SECRET=whsec_change-me

# ── GeoIP (MaxMind) ──
MAXMIND_LICENSE_KEY=change-me
GEOIP_DB_PATH=/app/data/GeoLite2-Country.mmdb

# ── CORS ──
CORS_ORIGINS=http://localhost:3000

# ── Frontend ──
VITE_API_URL=http://localhost:8000
